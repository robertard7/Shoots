<Window x:Class="Shoots.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Shoots.UI.Converters"
        xmlns:startup="clr-namespace:Shoots.UI.Startup"
        Title="{Binding WindowTitle}"
        Height="640"
        Width="860">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <Style x:Key="OperationBusyGlyphStyle" TargetType="TextBlock">
      <Setter Property="Opacity" Value="0.4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOperationBusyIndicatorVisible}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0.25"
                                 To="1"
                                 Duration="0:0:0.6" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="OperationStepStateStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFF8FAFC" />
      <Setter Property="BorderBrush" Value="#FFE5E7EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StepState}" Value="active">
          <Setter Property="Background" Value="#FFEFF6FF" />
          <Setter Property="BorderBrush" Value="#FF60A5FA" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StepState}" Value="completed">
          <Setter Property="Background" Value="#FFF0FDF4" />
          <Setter Property="BorderBrush" Value="#FF86EFAC" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StepState}" Value="failed">
          <Setter Property="Background" Value="#FFFEF2F2" />
          <Setter Property="BorderBrush" Value="#FFFCA5A5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT: WORKSPACE / STARTUP -->
    <StackPanel Grid.Column="0" Margin="0,0,16,0">

      <TextBlock Text="Project Workspace"
                 FontWeight="SemiBold"
                 ToolTip="{Binding WorkspaceIsolationTooltip}" />

      <TextBlock Margin="0,4,0,0"
                 Foreground="#FF6B7280"
                 Text="{Binding SessionStatusLabel}"
                 TextWrapping="Wrap" />

      <Border Margin="0,12,0,0"
              Background="#FFEFF6FF"
              BorderBrush="#FFBFDBFE"
              BorderThickness="1"
              Padding="10">
        <StackPanel>
          <TextBlock Text="Startup Status" FontWeight="SemiBold" />
          <UniformGrid Columns="2" Margin="0,8,0,0">
            <StackPanel Margin="0,0,12,0">
              <TextBlock FontSize="11" Foreground="#FF6B7280" Text="Provider" />
              <TextBlock FontWeight="SemiBold" Text="{Binding SelectedProviderMode}" />
            </StackPanel>
            <StackPanel>
              <TextBlock FontSize="11" Foreground="#FF6B7280" Text="Host Transport" />
              <TextBlock FontWeight="SemiBold" Text="{Binding SelectedHostTransport}" />
            </StackPanel>
            <StackPanel Margin="0,8,12,0">
              <TextBlock FontSize="11" Foreground="#FF6B7280" Text="Workspace" />
              <TextBlock Text="{Binding CurrentWorkspacePath}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0">
              <TextBlock FontSize="11" Foreground="#FF6B7280" Text="Last Verification" />
              <TextBlock Text="{Binding LastRunVerificationState}" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Button Margin="0,8,0,0"
              Content="New Project"
              Command="{Binding NewProjectCommand}"
              IsEnabled="{Binding CanStartNewProjectUi}"
              ToolTip="{Binding StartupButtonTooltip}"
              ToolTipService.ShowOnDisabled="True" />

      <Border Margin="0,8,0,0"
              Background="#FFFDF2F8"
              BorderBrush="#FFFBCFE8"
              BorderThickness="1"
              Padding="8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasNoProjectLoaded}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="No project loaded yet." FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0"
                     Foreground="#FF6B7280"
                     Text="Create a new project or choose a recent workspace to unlock demo runs and evidence capture."
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Margin="0,8,0,0"
              Background="#FFFFF1F2"
              BorderBrush="#FFFECACA"
              BorderThickness="1"
              Padding="10">
        <StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Last Failure" FontWeight="SemiBold" />
            <Button Margin="8,0,0,0"
                    Content="Copy failure summary"
                    Command="{Binding CopyLastFailureSummaryCommand}"
                    IsEnabled="{Binding HasLastFailure}" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding LastFailurePhase, StringFormat=Phase: {0}}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding LastFailureReason}"
                     TextWrapping="Wrap" />
          <StackPanel Margin="0,6,0,0">
            <TextBlock FontSize="11"
                       Foreground="#FF6B7280"
                       Text="Proof file path" />
            <TextBlock FontFamily="Consolas"
                       FontSize="11"
                       Text="{Binding LastFailureProofPath}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding LastFailureNextAction, StringFormat=Suggested next action: {0}}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasLastFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
      </Border>

      <TextBlock Margin="0,4,0,0"
                 Foreground="#FF6B7280"
                 Text="{Binding BusyOperation, StringFormat=Busy: {0}}"
                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <Border Margin="0,8,0,0"
              BorderThickness="1"
              Padding="10"
              Visibility="{Binding IsOperationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentOperationStatus}" Value="active">
                <Setter Property="Background" Value="#FFEFF6FF" />
                <Setter Property="BorderBrush" Value="#FF93C5FD" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CurrentOperationStatus}" Value="completed">
                <Setter Property="Background" Value="#FFF0FDF4" />
                <Setter Property="BorderBrush" Value="#FF86EFAC" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CurrentOperationStatus}" Value="failed">
                <Setter Property="Background" Value="#FFFEF2F2" />
                <Setter Property="BorderBrush" Value="#FFFCA5A5" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="Working Now" FontWeight="SemiBold" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding CurrentOperation, StringFormat=Operation: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding CurrentOperationStage, StringFormat=Stage: {0}}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="16"
                       Style="{StaticResource OperationBusyGlyphStyle}"
                       Text="⟳"
                       Visibility="{Binding IsOperationBusyIndicatorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ProgressBar Width="100"
                          Height="10"
                         Margin="8,0,0,0"
                         IsIndeterminate="True"
                          Visibility="{Binding IsOperationActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding OperationStatusLine}" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding OperationStatusDetail}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding BusyState, StringFormat=Busy state: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding CompletionHold, StringFormat=Completion hold: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ActionDisableReason, StringFormat=Action gate: {0}}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FFB45309"
                     Text="{Binding OperationWaitHint}"
                     TextWrapping="Wrap"
                     Visibility="{Binding IsOperationWaiting, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding OperationElapsedLabel}" />
          <TextBlock Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="Live Event" />
          <TextBlock Margin="0,2,0,0"
                      Text="{Binding OperationLatestEvent}"
                      TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="Live Narration Feed" />
          <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding NarrationFeed}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="11"
                           Foreground="#FF374151"
                           Text="{Binding}"
                           TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Margin="0,8,0,0"
                    Content="Show full timeline"
                    IsChecked="{Binding ShowFullTimeline, Mode=TwoWay}" />
          <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding VisibleOperationProgressSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,2,0,0" Style="{StaticResource OperationStepStateStyle}">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                      <Run Text="{Binding StepOrder}" />
                      <Run Text=". " />
                      <Run Text="{Binding StepName}" />
                    </TextBlock>
                    <TextBlock FontSize="11"
                               Foreground="#FF6B7280"
                               Text="{Binding StepState, StringFormat=State: {0}}" />
                    <TextBlock FontSize="11"
                               Text="{Binding StepDetail}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="Latest Run Artifact" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Text="{Binding LatestRunPath}"
                     TextWrapping="Wrap" />
          <Button Margin="0,4,0,0"
                  Content="Open Latest Run Folder"
                  Command="{Binding OpenLastRunFolderCommand}"
                  IsEnabled="{Binding HasLatestRunPath}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Validate Generated Output"
                    Command="{Binding ValidateGeneratedOutputCommand}" />
            <Button Margin="8,0,0,0"
                    Content="Attempt Repair"
                    Command="{Binding AttemptRepairCommand}"
                    ToolTip="{Binding AttemptRepairDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
          </StackPanel>
          <TextBlock Margin="0,4,0,0"
                     FontWeight="SemiBold"
                     Text="{Binding GeneratedOutputValidationBadge, StringFormat=Generated Output Status: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding GeneratedOutputValidationSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     FontFamily="Consolas"
                     Text="{Binding GeneratedOutputValidationRunId, StringFormat=Linked validation run: {0}}"
                     Visibility="{Binding HasGeneratedOutputValidationRunId, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     FontFamily="Consolas"
                     Text="{Binding GeneratedOutputValidationSourcePath}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding GeneratedOutputTrustBadge, StringFormat=Trust state: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding RepairPromotionBadge, StringFormat=Promotion status: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding RepairAdoptionBadge, StringFormat=Adoption status: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding RepairConfidenceText, StringFormat=Promotion confidence: {0}}"
                     Visibility="{Binding HasRepairConfidenceText, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding RepairPromotionSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding RepairAdoptionSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     FontFamily="Consolas"
                     Text="{Binding PromotedRepairId, StringFormat=Promoted repair: {0}}"
                     Visibility="{Binding HasPromotedRepairId, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Replay Latest Run"
                    Command="{Binding ReplayLatestRunCommand}"
                    IsEnabled="{Binding HasLatestRunPath}" />
            <Button Margin="8,0,0,0"
                    Content="Replay Selected Run"
                    Command="{Binding ReplaySelectedRunCommand}" />
          </StackPanel>
          <TextBlock Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="Replay Source"
                     Visibility="{Binding HasReplaySourcePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Text="{Binding ReplaySourcePath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasReplaySourcePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding ReplaySummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,4,0,0"
                     FontWeight="SemiBold"
                     Text="Replay Timing"
                     Visibility="{Binding HasReplayTimingSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Text="{Binding ReplayTimingSummary}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasReplayTimingSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FFB91C1C"
                     Text="{Binding ReplayMismatchSummary}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasReplayMismatch, Converter={StaticResource BooleanToVisibilityConverter}}" />

          <TextBlock Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="Validation" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationRepoRoot, StringFormat=Repo root: {0}}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationDisabledReason}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationDisabledReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="Build UI project"
                    Command="{Binding BuildUiProjectCommand}"
                    ToolTip="{Binding BuildUiProjectValidationDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0"
                    Content="Run UI tests"
                    Command="{Binding RunUiTestsCommand}"
                    ToolTip="{Binding RunUiTestsValidationDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0"
                    Content="Run smoke validation"
                    Command="{Binding RunSmokeValidationCommand}"
                    ToolTip="{Binding RunSmokeValidationDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0"
                    Content="Run integrity validation"
                    Command="{Binding RunIntegrityValidationCommand}"
                    ToolTip="{Binding RunIntegrityValidationDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0"
                    Content="Run full validation loop"
                    Command="{Binding RunFullValidationLoopCommand}"
                    ToolTip="{Binding RunFullValidationLoopDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
          </WrapPanel>
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding ValidationSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationRunModeBadge, StringFormat=Run mode: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding ValidationRunModeSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationSequenceSummary, StringFormat=Sequence: {0}}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationStabilityBadge, StringFormat=Validation confidence: {0}}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Open Validation Output"
                    Command="{Binding OpenValidationOutputFolderCommand}"
                    IsEnabled="{Binding HasValidationOutputFolder}" />
            <Button Margin="8,0,0,0"
                    Content="Open Failure Log"
                    Command="{Binding OpenValidationFailureLogCommand}"
                    IsEnabled="{Binding HasValidationFirstFailureLogPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Stability Artifact"
                    Command="{Binding OpenValidationStabilityArtifactCommand}"
                    IsEnabled="{Binding HasValidationStabilityArtifactPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Orchestration Artifact"
                    Command="{Binding OpenValidationOrchestrationArtifactCommand}"
                    IsEnabled="{Binding HasValidationOrchestrationArtifactPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Orchestration Note"
                    Command="{Binding OpenValidationOrchestrationNoteCommand}"
                    IsEnabled="{Binding HasValidationOrchestrationNotePath}" />
          </StackPanel>
          <TextBlock Margin="0,4,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Text="{Binding ValidationOutputFolder}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationOutputFolder, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FFB91C1C"
                     Text="{Binding ValidationFirstFailureText}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationFirstFailure, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationOrchestrationArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationOrchestrationArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationOrchestrationNotePath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationOrchestrationNotePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationIsolatedWorkspacePath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationIsolatedWorkspacePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationStabilityArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationStabilityArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationTrendBadge, StringFormat=Validation trend: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding ValidationTrendSummaryText}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationRegressionSummaryText}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,6,0,0"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationReleaseReadinessBadge, StringFormat=Release readiness: {0}}" />
          <TextBlock Margin="0,2,0,0"
                     Text="{Binding ValidationReleaseReadinessSummary}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationBaselineSummaryText}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationBaselineComparisonSummaryText}"
                     TextWrapping="Wrap" />
          <WrapPanel Margin="0,4,0,0">
            <Button Content="Set Release Baseline"
                    Command="{Binding SetReleaseBaselineCommand}"
                    ToolTip="{Binding SetReleaseBaselineDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Margin="8,0,0,0"
                    Content="Open Active Baseline"
                    Command="{Binding OpenValidationBaselineArtifactCommand}"
                    IsEnabled="{Binding HasValidationBaselineArtifactPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Baseline History"
                    Command="{Binding OpenValidationBaselineHistoryArtifactCommand}"
                    IsEnabled="{Binding HasValidationBaselineHistoryArtifactPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Baseline Comparison"
                    Command="{Binding OpenValidationBaselineComparisonArtifactCommand}"
                    IsEnabled="{Binding HasValidationBaselineComparisonArtifactPath}" />
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Open History Ledger"
                    Command="{Binding OpenValidationHistoryLedgerCommand}"
                    IsEnabled="{Binding HasValidationHistoryLedgerPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Trend Summary"
                    Command="{Binding OpenValidationTrendArtifactCommand}"
                    IsEnabled="{Binding HasValidationTrendArtifactPath}" />
            <Button Margin="8,0,0,0"
                    Content="Open Regression Summary"
                    Command="{Binding OpenValidationRegressionArtifactCommand}"
                    IsEnabled="{Binding HasValidationRegressionArtifactPath}" />
          </StackPanel>
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationHistoryLedgerPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationHistoryLedgerPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationTrendArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationTrendArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationRegressionArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationRegressionArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationBaselineArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationBaselineArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationBaselineHistoryArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationBaselineHistoryArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Margin="0,2,0,0"
                     FontFamily="Consolas"
                     FontSize="11"
                     Foreground="#FF6B7280"
                     Text="{Binding ValidationBaselineComparisonArtifactPath}"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasValidationBaselineComparisonArtifactPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Expander Margin="0,8,0,0"
                    Header="Builder Proof"
                    IsExpanded="{Binding IsBuilderProofExpanded, Mode=TwoWay}">
            <StackPanel>
              <TextBlock FontSize="11"
                         Foreground="#FF6B7280"
                         Text="{Binding BuilderProofModelId, StringFormat=Model floor: {0}}" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="#FF6B7280"
                         Text="{Binding BuilderProofOutcomeBadge, StringFormat=Repo-local proof: {0}}" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="#FF6B7280"
