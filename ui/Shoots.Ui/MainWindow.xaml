<Window x:Class="Shoots.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Shoots.UI.Converters"
        xmlns:startup="clr-namespace:Shoots.UI.Startup"
        Title="{Binding WindowTitle}"
        Height="640"
        Width="860">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
  </Window.Resources>

  <Grid Margin="24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT: WORKSPACE / STARTUP -->
    <StackPanel Grid.Column="0" Margin="0,0,16,0">

      <TextBlock Text="Project Workspace"
                 FontWeight="SemiBold"
                 ToolTip="{Binding WorkspaceIsolationTooltip}" />

      <TextBlock Margin="0,4,0,0"
                 Foreground="#FF6B7280"
                 Text="{Binding SessionStatusLabel}"
                 TextWrapping="Wrap" />

      <Button Margin="0,8,0,0"
              Content="New Project"
              Command="{Binding NewProjectCommand}"
              ToolTip="{Binding StartupButtonTooltip}"
              ToolTipService.ShowOnDisabled="True" />

      <!-- If startup is locked, you typically *can't* start another project. -->
      <Button Margin="0,6,0,0"
              Content="Start another project"
              Command="{Binding StartAnotherProjectCommand}"
              ToolTip="{Binding StartAnotherProjectTooltip}"
              ToolTipService.ShowOnDisabled="True"
              IsEnabled="{Binding IsStartupLocked}" />

      <TextBlock Margin="0,16,0,0"
                 Text="Recent Projects"
                 FontWeight="SemiBold" />

      <ListBox Margin="0,8,0,0"
               ItemsSource="{Binding RecentWorkspaces}"
               SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
               DisplayMemberPath="Name">

        <ListBox.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Remove from list"
                      Command="{Binding RemoveWorkspaceCommand}"
                      CommandParameter="{Binding SelectedWorkspace}" />
            <MenuItem Header="Open folder"
                      Command="{Binding OpenWorkspaceCommand}"
                      CommandParameter="{Binding SelectedWorkspace}" />
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#FF2B6CB0" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </ListBox.ItemContainerStyle>

      </ListBox>

      <TextBlock Margin="0,8,0,0"
                 Text="No recent projects yet."
                 Foreground="#FF6B7280"
                 Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <TextBlock Margin="0,8,0,0"
                 Text="Select a project to preview workspace scripts."
                 Foreground="#FF6B7280"
                 Visibility="{Binding HasNoActiveWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <TextBlock Margin="0,16,0,0"
                 Text="{Binding ActiveWorkspaceName}" />

      <!-- TOOL TIER -->
      <GroupBox Margin="0,12,0,0" Header="Tool Tier">
        <StackPanel Margin="8">

          <Border Background="#FFEFF6FF" CornerRadius="4" Padding="6">
            <TextBlock Text="{Binding ActiveToolpackTierLabel}"
                       ToolTip="{Binding ActiveToolpackTierTooltip}" />
          </Border>

          <TextBlock Margin="0,6,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding SystemTierNote}"
                     TextWrapping="Wrap" />

          <ComboBox Margin="0,6,0,0"
                    ItemsSource="{Binding ToolpackTierOptions}"
                    SelectedItem="{Binding SelectedToolpackTier, Mode=TwoWay}"
                    IsEnabled="{Binding CanSelectToolpackTier}" />

          <Button Margin="0,6,0,0"
                  Content="{Binding SystemTierActionLabel}"
                  Command="{Binding ToggleSystemTierCommand}"
                  ToolTip="{Binding ActiveToolpackTierTooltip}"
                  ToolTipService.ShowOnDisabled="True"
                  IsEnabled="{Binding HasActiveWorkspace}" />

        </StackPanel>
      </GroupBox>

      <!-- ROLE -->
      <GroupBox Margin="0,12,0,0" Header="Role">
        <StackPanel Margin="8">

          <ComboBox ItemsSource="{Binding RoleOptions}"
                    SelectedItem="{Binding SelectedRole}"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding HasActiveWorkspace}" />

          <TextBlock Margin="0,6,0,0"
                     Foreground="#FF6B7280"
                     Text="{Binding SelectedRoleDescription}"
                     TextWrapping="Wrap" />

        </StackPanel>
      </GroupBox>

      <Expander Margin="0,12,0,0"
                Header="Action Log (Debug)"
                Visibility="{Binding IsDebugBuild, Converter={StaticResource BooleanToVisibilityConverter}}"
                IsExpanded="False">
        <Border BorderBrush="#FFD1D5DB" BorderThickness="1" Padding="6">
          <ListBox ItemsSource="{Binding ActionLogLines}"
                   Height="180"
                   FontFamily="Consolas"
                   FontSize="11" />
        </Border>
      </Expander>

    </StackPanel>

    <!-- RIGHT: MAIN TABS -->
    <TabControl Grid.Column="1" SelectedIndex="0">

      <!-- CHAT INTAKE -->
      <TabItem Header="Chat Intake">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>

          <!-- Sessions -->
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Sessions / WorkOrders" FontWeight="SemiBold" />

            <ListBox Margin="0,8,0,0"
                     ItemsSource="{Binding ChatSessions}"
                     SelectedItem="{Binding SelectedChatSession, Mode=TwoWay}">

              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding WorkOrderId}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlanHash}" FontSize="11" Foreground="#FF6B7280" />
                    <TextBlock Text="{Binding LastStatus}" FontSize="11" />
                    <TextBlock Text="{Binding LastUpdatedUtc}" FontSize="10" Foreground="#FF6B7280" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>
          </StackPanel>

          <!-- Intake -->
          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="Chat / Intake" FontWeight="SemiBold" />

            <TextBlock Margin="0,8,0,0" Text="Intent" />
            <TextBox Text="{Binding IntakeIntent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="{Binding IsWorkOrderLocked}" />

            <TextBlock Margin="0,8,0,0" Text="Target" />
            <TextBox Text="{Binding IntakeTarget, Mode=TwoWay}"
                     IsReadOnly="{Binding IsWorkOrderLocked}" />

            <TextBlock Margin="0,8,0,0" Text="Attachments (one per line / csv)" />
            <TextBox Text="{Binding IntakeAttachments, Mode=TwoWay}"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="{Binding IsWorkOrderLocked}" />

            <TextBlock Margin="0,8,0,0" Text="Stack" />
            <TextBox Text="{Binding IntakeStack, Mode=TwoWay}"
                     IsReadOnly="{Binding IsWorkOrderLocked}" />

            <TextBlock Margin="0,8,0,0" Text="Model" />
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="220"
                          ItemsSource="{Binding AvailableModels}"
                          SelectedItem="{Binding SelectedModelId, Mode=TwoWay}" />
                <Button Margin="8,0,0,0"
                        Content="Refresh"
                        Command="{Binding RefreshBackendStatusCommand}"
                        ToolTip="{Binding RefreshBackendsDisabledReason}"
                        ToolTipService.ShowOnDisabled="True" />
                <Button Margin="8,0,0,0"
                        Content="Reset catalog"
                        Command="{Binding ResetModelCatalogCommand}" />
                <Button Margin="8,0,0,0"
                        Content="Open .state"
                        Command="{Binding OpenStateFolderCommand}" />
              </StackPanel>

              <TextBlock Margin="0,4,0,0"
                         FontSize="11"
                         Foreground="#FF6B7280"
                         Text="{Binding DefaultModelId, StringFormat=Default model: {0}}" />

              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="#FFB91C1C"
                         TextWrapping="Wrap"
                         Text="{Binding ModelCatalogError}"
                         Visibility="{Binding HasModelCatalogError, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="#FF6B7280"
                         Text="{Binding OllamaEndpoint, StringFormat=Ollama Endpoint: {0}}" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="#FF6B7280"
                         Text="{Binding QdrantEndpoint, StringFormat=Qdrant Endpoint: {0}}" />
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="#FFB91C1C"
                         TextWrapping="Wrap"
                         Text="{Binding BackendDisabledReason}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="Lock WorkOrder" Command="{Binding LockWorkOrderCommand}" />
              <Button Margin="8,0,0,0" Content="Unlock" Command="{Binding UnlockWorkOrderCommand}" />
              <Button Margin="8,0,0,0" Content="Generate Plan" Command="{Binding GeneratePlanCommand}" />
              <Button Margin="8,0,0,0"
                      Content="Run"
                      Command="{Binding RunIntakePlanCommand}"
                      ToolTip="{Binding RunIntakePlanDisabledReason}"
                      ToolTipService.ShowOnDisabled="True" />
              <Button Margin="8,0,0,0" Content="Quick Start" Command="{Binding QuickStartCommand}" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0"
                       Text="{Binding JobSpecDigest}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="11" />

            <ListBox Margin="0,8,0,0"
                     ItemsSource="{Binding ChatMessages}"
                     Height="140" />

            <GroupBox Margin="0,8,0,0" Header="Operator Health">
              <StackPanel Margin="8,4,8,8">
                <TextBlock Text="{Binding CatalogHash, StringFormat=Catalog Hash: {0}}"
                           FontFamily="Consolas"
                           FontSize="11" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding SelectedModelId, StringFormat=Selected Model: {0}}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding LastWorkOrderId, StringFormat=Last WorkOrder: {0}}"
                           FontFamily="Consolas"
                           FontSize="11" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding LastRunStatus, StringFormat=Last Status: {0}}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding LastSmokeRunId, StringFormat=Last Smoke Run: {0}}"
                           FontFamily="Consolas"
                           FontSize="11" />
              </StackPanel>
            </GroupBox>

          </StackPanel>

          <!-- Right-side nested tabs -->
          <TabControl Grid.Column="2">

            <TabItem Header="WorkOrder">
              <StackPanel Margin="8">
                <TextBlock Text="Digest" FontWeight="SemiBold" />
                <TextBlock Text="{Binding JobSpecDigest}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11" />
              </StackPanel>
            </TabItem>

            <TabItem Header="Plan">
              <StackPanel Margin="8">
                <TextBlock Text="PlanHash" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PlanHashLabel}" FontFamily="Consolas" />
                <TextBlock Margin="0,8,0,0" Text="PlanId" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PlanIdLabel}" FontFamily="Consolas" />
              </StackPanel>
            </TabItem>

            <TabItem Header="Waiting">
              <StackPanel Margin="8">

                <TextBlock Text="Decision Gate"
                           FontWeight="SemiBold"
                           Visibility="{Binding LastWaitingInfo, Converter={StaticResource NullToVisibilityConverter}}" />

                <Border Background="#FFEFF6FF" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                  <TextBlock Text="{Binding WaitingExplanation}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Reason" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.ReasonCode}" />

                <TextBlock Text="Gate" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.RouteGateId}" FontFamily="Consolas" FontSize="11" />

                <TextBlock Text="Node" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.CurrentNodeId}" FontFamily="Consolas" FontSize="11" />

                <TextBlock Text="Prompt Key" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.DecisionPromptKey}" />

				<TextBlock Text="Gate decision" FontWeight="SemiBold" Margin="0,8,0,0" />
				<TextBlock Text="{Binding LastWaitingInfo.GateDecision}" />

                <TextBlock Text="Fallback" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.FallbackPresent}" />

                <TextBlock Text="Allowed Next Nodes" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding LastWaitingInfo.AllowedNextNodes}" />

                <TextBlock Text="Run Mode" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding RunModes}"
                          SelectedItem="{Binding SelectedRunMode, Mode=TwoWay}" />

                <TextBlock Text="Decision Tool Id" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding LastWaitingInfo.AllowedNextNodes}"
                          SelectedItem="{Binding DecisionToolId, Mode=TwoWay}"
                          IsEditable="True" />

                <TextBlock Text="Decision Bindings (json)" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding DecisionBindingsJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="11" />

                <TextBlock Text="Injected Decision Digest" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding InjectedDecisionDigest}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11" />

                <TextBlock Text="PlanHash" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.PlanHash}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11" />

                <TextBlock Text="WorkOrderId" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding LastWaitingInfo.WorkOrderId}" FontFamily="Consolas" FontSize="11" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Use fallback tool" Command="{Binding UseFallbackToolCommand}" />
                  <Button Margin="8,0,0,0" Content="Resume with selection" Command="{Binding ResumeInjectDecisionCommand}" />
                  <Button Margin="8,0,0,0" Content="Copy resume payload" Command="{Binding CopyResumePayloadCommand}" />
                </StackPanel>

                <TextBlock Text="Resume payload" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox Text="{Binding LastResumePayload}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11" />

              </StackPanel>
            </TabItem>

            <TabItem Header="Trace">
              <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                  <TextBox Width="180"
                           Text="{Binding TraceFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <ComboBox Width="140"
                            Margin="8,0,0,0"
                            ItemsSource="{Binding TraceEventFilters}"
                            SelectedItem="{Binding TraceEventFilter, Mode=TwoWay}" />
                  <Button Margin="8,0,0,0" Content="Copy Trace" Command="{Binding CopyTraceCommand}" />
                  <Button Margin="8,0,0,0" Content="Copy Trace Path" Command="{Binding CopyTracePathCommand}" />
                </StackPanel>

                <ListBox Margin="0,8,0,0" ItemsSource="{Binding FilteredTraceEntries}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Width="36" Text="{Binding Tick}" FontFamily="Consolas" />
                        <TextBlock Width="200" Text="{Binding Event}" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>

            <TabItem Header="Artifacts">
              <StackPanel Margin="8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Artifacts output:" />
                  <TextBlock Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             Text="{Binding ArtifactsOutputPath}"
                             FontFamily="Consolas"
                             FontSize="11" />
                  <Button Margin="8,0,0,0" Content="Copy path" Command="{Binding CopyArtifactsPathCommand}" />
                </StackPanel>

                <ListBox Margin="0,8,0,0" ItemsSource="{Binding Artifacts}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="11" />
                        <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="0,8,0,0" Text="Copied payload / trace" FontWeight="SemiBold" />
                <TextBox Height="70"
                         Text="{Binding LastTracePayload}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11" />
              </StackPanel>
            </TabItem>

            <TabItem Header="Tool Catalog">
              <StackPanel Margin="8">
                <TextBlock Text="Deterministic tool catalog snapshot" FontWeight="SemiBold" />
                <ListBox Margin="0,8,0,0" ItemsSource="{Binding ToolCatalogEntries}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding ToolId}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#FF6B7280" />
                        <TextBlock Text="{Binding Authority}" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </TabItem>

            <TabItem Header="Narration">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center" Text="Phase" Margin="0,0,8,0" />
            <ComboBox Width="180" ItemsSource="{Binding NarrationPhaseOptions}" SelectedItem="{Binding SelectedNarrationPhase, Mode=TwoWay}" />
            <Button Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshNarrationCommand}" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding NarrationLines}" FontFamily="Consolas" FontSize="11" />
        </Grid>
      </TabItem>

    </TabControl>
        </Grid>
      </TabItem>

      <!-- STARTUP -->
      <TabItem Header="Startup" IsEnabled="{Binding IsStartupTabEnabled}">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Background="#FFF3F4F6" Padding="12" CornerRadius="4">
            <StackPanel>
              <TextBlock Text="Startup Flow" FontWeight="SemiBold" />

              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="State:" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StartupStateLabel}" Margin="6,0,0,0" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Entry path:" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StartupEntryPathLabel}" Margin="6,0,0,0" />
              </StackPanel>

              <TextBlock Margin="0,6,0,0"
                         Foreground="#FF6B7280"
                         Text="{Binding StartupProviderLabel}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="1"
                      Margin="0,16,0,0"
                      Visibility="{Binding IsEntryPathSelectionActive, Converter={StaticResource BooleanToVisibilityConverter}}">

            <TextBlock Text="Choose how you want to begin:" FontWeight="SemiBold" />

            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
              <Button Width="170"
                      Content="Start something new"
                      Command="{Binding SelectEntryPathCommand}"
                      CommandParameter="{x:Static startup:StartupEntryPath.StartSomethingNew}" />
              <Button Width="200"
                      Margin="8,0,0,0"
                      Content="Continue an existing project"
                      Command="{Binding SelectEntryPathCommand}"
                      CommandParameter="{x:Static startup:StartupEntryPath.ContinueExistingProject}" />
              <Button Width="170"
                      Margin="8,0,0,0"
                      Content="Just explore an idea"
                      Command="{Binding SelectEntryPathCommand}"
                      CommandParameter="{x:Static startup:StartupEntryPath.ExploreIdea}" />
            </StackPanel>

            <TextBlock Margin="0,8,0,0"
                       Foreground="#FF6B7280"
                       Text="Select exactly one path to continue."
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,16,0,0">

            <Border Background="#FFF3F4F6" Padding="10" CornerRadius="4"
                    Visibility="{Binding IsStartNewLanguageActive, Converter={StaticResource BooleanToVisibilityConverter}}">
              <StackPanel>
                <TextBlock Text="Supported languages" FontWeight="SemiBold" />
                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding StartupLanguageOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <GroupBox Margin="0,12,0,0" Header="Startup Chat">
              <ListBox Margin="8" ItemsSource="{Binding StartupMessages}" />
            </GroupBox>

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding StartupPrompt}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <TextBox Width="360"
                       Text="{Binding StartupInput, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding IsStartupInputActive}" />
              <Button Width="110"
                      Margin="8,0,0,0"
                      Content="Send"
                      Command="{Binding SubmitStartupInputCommand}"
                      IsEnabled="{Binding IsStartupInputActive}" />
            </StackPanel>

          </StackPanel>
        </Grid>
      </TabItem>

      <!-- EXECUTION -->
      <TabItem Header="Execution">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Background="#FFEFF6FF" Padding="12" CornerRadius="4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Execution State:" FontWeight="SemiBold" />
              <TextBlock Text="{Binding StateLabel}" Margin="8,0,0,0" />
              <TextBlock Text="Replay Mode"
                         Margin="16,0,0,0"
                         ToolTip="Replay mode is read-only and trace-backed."
                         Visibility="{Binding IsReplayMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Width="110"
                    Content="Start"
                    Command="{Binding StartCommand}"
                    ToolTip="{Binding StartDisabledReason}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Width="110" Margin="8,0,0,0"
                    Content="Cancel"
                    Command="{Binding CancelCommand}" />
            <Button Width="140" Margin="8,0,0,0"
                    Content="Refresh Status"
                    Command="{Binding RefreshStatusCommand}" />
            <Button Width="140" Margin="8,0,0,0"
                    Content="Explain Execution"
                    Command="{Binding ExplainExecutionCommand}"
                    ToolTip="Describe execution context using AI Help."
                    Visibility="{Binding CanRenderAiExplainButtons, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>

          <StackPanel Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="{Binding ExecutionModeSummary}" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ExecutionProviderSummary}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding ExecutionGraphSummary}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#FF6B7280"
                       Text="{Binding ExecutionDisabledReason}"
                       TextWrapping="Wrap" />

            <GroupBox Margin="0,12,0,0" Header="Resolved Steps">
              <ListBox Margin="8" ItemsSource="{Binding ExecutionPlanSteps}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4,0,4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                        <Border Margin="8,0,0,0"
                                Background="{Binding OwnerColor}"
                                CornerRadius="4"
                                Padding="4,1">
                          <TextBlock Foreground="White"
                                     Text="{Binding OwnerLabel}"
                                     ToolTip="{Binding OwnerHint}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Foreground="#FF6B7280"
                                 Text="{Binding Id}"
                                 TextWrapping="Wrap" />
